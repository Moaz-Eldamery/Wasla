# Copy to .env and replace every value before running anywhere but your own
# machine. Never commit .env. Fake values only.

# Gateway (Traefik): the only way into the system.
GATEWAY_PORT=8080
# Uptime Kuma dashboard, bound to localhost only.
KUMA_PORT=3001

# Postgres superuser. Used only by database/init.sh on the first start.
POSTGRES_PASSWORD=fake-postgres-password
# One DB user per service, plus the migrations user (see schema.md).
MIGRATOR_DB_PASSWORD=fake-migrator-password
AUTH_DB_PASSWORD=fake-auth-password
CORE_DB_PASSWORD=fake-core-password
AI_DB_PASSWORD=fake-ai-password

REDIS_PASSWORD=fake-redis-password

# MinIO (private file storage for results). The password needs 8+ characters.
MINIO_ROOT_USER=wasla-minio
MINIO_ROOT_PASSWORD=fake-minio-password
MINIO_RESULTS_BUCKET=wasla-results

# Claude API key for the AI service.
ANTHROPIC_API_KEY=sk-ant-fake-key
