{
  "name": "wasla",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "build": "pnpm -r --if-present build",
    "mock": "prism mock contracts/openapi.yaml --port 4010",
    "db:migrate": "prisma migrate deploy --config database/clinical/prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config database/clinical/prisma.config.ts"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.16.0",
    "prisma": "7.10.1"
  }
}
